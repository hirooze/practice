# -*- mode: ruby -*-
# vi: set ft=ruby :

Vagrant.configure("2") do |config|
  # Rocky Linux 9 ボックスを使用
  config.vm.box = "generic/rocky9"
  
  # ホスト名の設定
  config.vm.hostname = "rocky9test"
  
  # プライベートネットワークの設定
  config.vm.network "private_network", ip: "192.168.100.1"
  
  # VirtualBox固有の設定
  config.vm.provider "virtualbox" do |vb|
    # VM名の設定
    vb.name = "rocky9test"
    
    # CPUコア数の設定
    vb.cpus = 2
    
    # メモリサイズの設定（MB単位）
    vb.memory = 4096
    
    # GUIモードを無効化
    vb.gui = false
    
  end
end
